<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jexray</groupId>
    <artifactId>jexray-jadx-plugin</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>Jexray JADX Native View Plugin</name>
    <description>Detect native (JNI) methods in an APK and view Ghidra pseudocode/disassembly</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <jadx.version>1.5.5</jadx.version>
        <rsyntaxtextarea.version>3.6.1</rsyntaxtextarea.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencies>
        <!-- jadx plugin API. Provided by the host application at runtime; must NOT be shaded. -->
        <dependency>
            <groupId>io.github.skylot</groupId>
            <artifactId>jadx-core</artifactId>
            <version>${jadx.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Shaded third-party libs -->
        <dependency>
            <groupId>com.fifesoft</groupId>
            <artifactId>rsyntaxtextarea</artifactId>
            <version>${rsyntaxtextarea.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- version in the artifact name, matching the release-asset convention -->
        <finalName>jexray-${project.version}</finalName>
        <resources>
            <!-- filter only build.properties so ${project.version} is injected at build time -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>jexray/build.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>jexray/build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <artifactSet>
                                <excludes>
                                    <!-- never bundle jadx or its transitive API deps -->
                                    <exclude>io.github.skylot:*</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                    <!-- CLASS-retention annotations pulled in transitively by
                                         gson; nothing reads them at runtime, and bundling them
                                         unrelocated would squat com.google.errorprone inside the
                                         host's classloader. -->
                                    <exclude>com.google.errorprone:*</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.jexray.shaded.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.fife</pattern>
                                    <shadedPattern>com.jexray.shaded.fife</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- the plain exclude above misses the multi-release
                                             copies; a descriptor whose exported packages were all
                                             relocated away is dead weight at best. -->
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
